#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        HM: HM {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <400>;
            require-prior-idle-ms = <400>;
            flavor = "balanced";
        };

        HL: HL {
            compatible = "zmk,behavior-hold-tap";
            label = "HL";
            bindings = <&mo>, <&tog>;
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <400>;
            require-prior-idle-ms = <400>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTZ";
            bindings = <
                &kp ESC        &kp Q        &kp W           &kp E           &kp R         &kp T     &none   &none &kp Z    &kp U              &kp I            &kp O            &kp P           &kp BSPC
                &kp TAB        &HM LCTRL A  &HM LEFT_ALT S  &HM LEFT_WIN D  &HM LSHIFT F  &kp G     &none   &none &kp H    &HM RIGHT_SHIFT J  &HM RIGHT_WIN K  &HM RIGHT_ALT L  &HM RCTRL SEMI  &kp SQT
                &kp BACKSLASH  &kp Y        &kp X           &kp C           &kp V         &kp B                   &kp N    &kp M              &kp COMMA        &kp DOT          &kp FSLH        &kp DEL
                                                            &kp LEFT_WIN    &HL 2 2       &kp SPACE               &kp RET  &HL 1 1            &HL 3 3
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        lower_layer {
            display-name = "NUMBERS";
             bindings = <
                &none        &kp EQUAL        &kp N7        &kp N8        &kp NUMBER_9  &kp MINUS     &none   &none &none     &kp PAGE_UP    &kp UP_ARROW    &kp PAGE_DOWN  &none         &kp BSPC
                &none        &kp KP_MULTIPLY  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS      &none   &none &kp HOME  &kp LEFT       &kp DOWN_ARROW  &kp RIGHT      &kp END       &none
                &none        &kp SLASH        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0                 &none   &none            &kp COMMA        &kp DOT        &none         &kp DEL
                                                                    &to 0         &none         &kp SPACE               &kp RET     &none             &none
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
                &none     &none     &none     &none     &none       &none     &none   &none &none     &none     &kp LPAR  &kp RPAR  &none     &kp BSPC
                &kp AMPS  &kp EXCL  &kp AT    &kp HASH  &kp DOLLAR  &kp PERCENT &none   &none &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
                &none     &none     &none     &none     &none       &none               &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
                                                  &to 0     &none     &kp SPACE               &kp RET    &none     &none
            >;
        };

        extra_layer_1 {
            display-name = "SETTINGS";
            bindings = <
                &sys_reset     &none         &none         &none         &none         &none         &none   &none &none     &none            &kp C_VOLUME_UP  &kp C_MUTE    &none   &none
                &bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none   &none &none     &kp C_PREVIOUS   &kp C_PLAY_PAUSE &kp C_NEXT   &none  &none
                &bootloader    &none         &none         &none         &rgb_ug RGB_TOG  &none                      &none     &none          &kp C_VOL_DN   &none   &none  &none
                                                           &to 0         &none         &none                      &none     &none            &none
            >;
        };
    };
};
