#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HM: HM {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            flavor = "balanced";
            quick-tap-ms = <400>;
            require-prior-idle-ms = <400>;
        };

        HL: HL {
            compatible = "zmk,behavior-hold-tap";
            label = "HL";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <400>;
            require-prior-idle-ms = <400>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwertz {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp ESC        &kp Q        &kp W           &kp E           &kp R         &kp T        &kp Z    &kp U              &kp I            &kp O            &kp P           &kp BSPC
&kp TAB        &HM LCTRL A  &HM LEFT_ALT S  &HM LEFT_WIN D  &HM LSHIFT F  &kp G        &kp H    &HM RIGHT_SHIFT J  &HM RIGHT_WIN K  &HM RIGHT_ALT L  &HM RCTRL SEMI  &kp SQT
&kp BACKSLASH  &kp Y        &kp X           &kp C           &kp V         &kp B        &kp N    &kp M              &kp COMMA        &kp DOT          &kp FSLH        &kp DEL
                                            &kp LEFT_WIN    &HL 2 2       &kp SPACE    &kp RET  &HL 1 1            &HL 3 3
            >;
        };

        numbers {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&none  &kp EQUAL        &kp N7        &kp N8        &kp NUMBER_9  &kp MINUS       &none     &kp PAGE_UP  &kp UP_ARROW    &kp PAGE_DOWN  &none    &kp BSPC
&none  &kp KP_MULTIPLY  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS        &kp HOME  &kp LEFT     &kp DOWN_ARROW  &kp RIGHT      &kp END  &none
&none  &kp SLASH        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0    &none     &none        &kp COMMA       &kp DOT        &none    &kp DEL
                                      &none         &none         &kp SPACE       &kp RET   &none        &none
            >;
        };

        symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&none  &none     &none   &none     &none       &none          &none      &none      &kp LPAR  &kp RPAR  &none     &kp BSPC
&none  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
&none  &none     &none   &none     &none       &none          &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
                         &none     &none       &kp SPACE      &kp RET    &none      &none
            >;
        };

        settings {
            bindings = <
&sys_reset   &none         &none         &none         &none         &none           &none  &none           &kp C_VOLUME_UP   &kp C_MUTE  &none  &none
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &none  &none
&bootloader  &none         &none         &bl BL_TOG    &bl BL_CYCLE  &none           &none  &none           &kp C_VOL_DN      &none       &none  &none
                                         &none         &none         &none           &none  &none           &none
            >;
        };
    };
};
